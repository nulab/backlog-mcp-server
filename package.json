{
  "name": "backlog-mcp-server",
  "version": "0.20.6",
  "type": "module",
  "bin": {
    "backlog-mcp-server": "./build/index.js"
  },
  "main": "./build/lib.js",
  "types": "./build/lib.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib.d.ts",
      "import": "./build/lib.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.4+sha512.8768be55200ae3f2226b6527fcca2687e14bc4e5f12d7721a0f25da3df47915177058648db4177baf348120fa0ba2752d8d8d93f6beaf1fe64ae18da8de961af",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22",
      "onFail": "warn"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nulab/backlog-mcp-server.git"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && chmod 755 build/index.js",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:coverage": "vp test run --coverage",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --check src vite.config.ts",
    "format:fix": "vp fmt src vite.config.ts"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/hono": "^2.0.1",
    "@modelcontextprotocol/server": "^2.2.0",
    "backlog-js": "^0.20.1",
    "env-var": "^7.5.0",
    "hono": "^4.13.12",
    "js-yaml": "^5.4.2",
    "pino": "^10.3.1",
    "yargs": "^18.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "catalog:",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
