{
  "name": "backlog-mcp-server",
  "version": "0.18.0",
  "type": "module",
  "bin": {
    "backlog-mcp-server": "./build/index.js"
  },
  "main": "./build/lib.js",
  "types": "./build/lib.d.ts",
  "exports": {
    ".": {
      "types": "./build/lib.d.ts",
      "import": "./build/lib.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.4+sha512.8768be55200ae3f2226b6527fcca2687e14bc4e5f12d7721a0f25da3df47915177058648db4177baf348120fa0ba2752d8d8d93f6beaf1fe64ae18da8de961af",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22",
      "onFail": "warn"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nulab/backlog-mcp-server.git"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "tsx src/index.ts",
    "build": "tsc && chmod 755 build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt --check src vitest.config.ts",
    "format:fix": "oxfmt src vitest.config.ts"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "backlog-js": "^0.19.1",
    "env-var": "^7.5.0",
    "hono": "^4.13.5",
    "js-yaml": "^5.4.1",
    "pino": "^10.3.1",
    "yargs": "^18.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^4.1.11",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
